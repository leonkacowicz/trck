# Scoping the pick scopes its context too: work in flight elsewhere is not this
# subtree's business.
new "Here" --id aaaaaaa --priority high --empty
new "Here taken" --id bbbbbbb --parent aaaaaaa --priority high --empty
new "Here free" --id ccccccc --parent aaaaaaa --priority urgent --empty
new "Elsewhere taken" --id ddddddd --priority high --empty
start bbbbbbb
start ddddddd
