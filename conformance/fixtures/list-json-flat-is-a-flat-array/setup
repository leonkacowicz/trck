# The flat form drops the nesting but keeps the order the forest would have used, so
# the blocker still precedes the issue waiting on it.
new "Epic" --id aaaaaaa --empty
new "Kid" --id bbbbbbb --parent aaaaaaa --empty
new "Grandkid" --id ccccccc --parent bbbbbbb --empty
new "Blocker" --id ddddddd --empty
dep bbbbbbb --add ddddddd
set bbbbbbb --field area=core
label ddddddd --add urgent
