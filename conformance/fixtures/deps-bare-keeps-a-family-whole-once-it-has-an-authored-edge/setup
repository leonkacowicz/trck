# Once a family carries one authored edge the whole family is shown, sibling included —
# a partially-shown epic would misreport what it needs.
new "Blocker" --id aaaaaaa --empty
new "Epic" --id bbbbbbb --empty
new "Kid" --id ccccccc --parent bbbbbbb --requires aaaaaaa --empty
new "Sibling" --id ddddddd --parent bbbbbbb --empty
