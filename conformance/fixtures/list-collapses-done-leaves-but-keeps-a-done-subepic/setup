# Mid's children are all done so Mid is terminal, but its parent is still open: Mid stays
# as context while its own done leaves collapse underneath it.
new "Epic" --id aaaaaaa --empty
new "Mid" --id bbbbbbb --parent aaaaaaa --empty
new "g1" --id ccccccc --parent bbbbbbb --empty
new "g2" --id ddddddd --parent bbbbbbb --empty
new "Open" --id eeeeeee --parent aaaaaaa --empty
done ccccccc
done ddddddd
