# Scoping to an epic narrows *what is listed*, never the blocking rules or the ranking, both of
# which stay global. The blocked child is blocked by an issue outside the subtree, and must not
# look actionable just because the blocker is out of view.
new "Outside" --id aaaaaaa --empty
new "Epic" --id bbbbbbb --empty
new "In subtree, blocked from outside" --id ccccccc --parent bbbbbbb --requires aaaaaaa --empty
new "In subtree, free" --id ddddddd --parent bbbbbbb --empty
