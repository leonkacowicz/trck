# 1 forks to two independent chains 1->2->4 and 1->3->5. Locality finishes one chain
# (1,2,4) before starting the other (3,5) rather than interleaving by id.
new "Root" --id aaaaaaa
new "A1" --id bbbbbbb --depends aaaaaaa
new "B1" --id ccccccc --depends aaaaaaa
new "A2" --id ddddddd --depends bbbbbbb
new "B2" --id eeeeeee --depends ccccccc
