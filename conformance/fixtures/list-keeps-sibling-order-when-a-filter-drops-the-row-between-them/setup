# Same graph as list-orders-siblings-by-a-constraint-through-another-subtree, with the
# issue that orders the two siblings filtered out. The rank is computed over the whole
# graph, so it does not change when rows are dropped from the view — an order computed
# over only what is shown would fall back to the tie-break here and swap them.
new "Epic" --id aaaaaaa --empty
new "Later step" --id bbbbbbb --parent aaaaaaa --empty
new "Earlier step" --id ccccccc --parent aaaaaaa --empty
new "Middle" --id ddddddd --empty
dep bbbbbbb --add ddddddd
dep ddddddd --add ccccccc
