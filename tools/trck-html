#!/usr/bin/env python3
"""tools/trck-html — generate a static, self-contained HTML SPA to browse a trck tracker.

A standalone accessory (NOT part of the amalgamated engine): it loads the generated
`./trck` engine at runtime and reuses its Graph/config API, so no tracker logic is
duplicated. Standard-library only. Output is one HTML file with an embedded JSON data
island plus inline CSS/JS — no network needed to open it. Read-only; see epic #fkrp9dh.

    ./tools/trck-html              # discover tracker -> <tracker>/issues.html
    ./tools/trck-html -o out.html
    ./tools/trck-html -o -         # stdout
    ./tools/trck-html PATH         # point at a specific tracker/repo
"""
from __future__ import annotations

import argparse
import html as _html
import importlib.machinery
import importlib.util
import json
import os
import shutil
import sys
from pathlib import Path


# --------------------------------------------------------------------------- #
# Engine loading — find the generated ./trck and import it as a module.
# --------------------------------------------------------------------------- #
def _load_engine():
    """Locate and import the trck engine. Resolution order: $TRCK_ENGINE, a
    committed copy beside a trck.json walking up from cwd, then a global `trck`."""
    candidates = []
    env = os.environ.get("TRCK_ENGINE")
    if env:
        candidates.append(Path(env))
    d = Path.cwd().resolve()
    while True:
        has_cfg = (d / "issues" / "trck.json").exists() or (d / "trck.json").exists()
        if has_cfg:
            for c in (d / "issues" / "trck", d / "trck"):
                if c.is_file():
                    candidates.append(c)
        if d.parent == d:
            break
        d = d.parent
    on_path = shutil.which("trck")
    if on_path:
        candidates.append(Path(on_path))

    for c in candidates:
        if c and c.is_file():
            loader = importlib.machinery.SourceFileLoader("trck_engine", str(c))
            spec = importlib.util.spec_from_file_location("trck_engine", str(c), loader=loader)
            mod = importlib.util.module_from_spec(spec)
            sys.modules["trck_engine"] = mod
            spec.loader.exec_module(mod)
            return mod
    raise SystemExit(
        "trck-html: could not locate the trck engine "
        "(set $TRCK_ENGINE, or run inside a trck repo)"
    )


E = _load_engine()


# --------------------------------------------------------------------------- #
# Model — flatten the Graph into a plain, JSON-serialisable structure.
# --------------------------------------------------------------------------- #
def build_ctx_from(path=None):
    """Resolve a tracker to a Ctx. `path` may be a tracker dir or a repo root
    (walked/globbed by the engine); None discovers from cwd like `trck` itself."""
    if path:
        d = E.find_tracker(Path(path))
    else:
        d = E.resolve_tracker_dir(None)
    return E.Ctx(d, E.load_config(d))


def _body_text(ctx, r):
    try:
        return E.issue_path(ctx, r).read_text()
    except OSError:
        return ""


def _progress(g, r):
    if g.is_leaf(r):
        return None
    pdone, ptotal, ndone, ntotal = E.leaf_rollup(g, r)
    return {
        "pct": round(100 * pdone / ptotal) if ptotal else 0,
        "done_points": pdone, "total_points": ptotal,
        "done_count": ndone, "total_count": ntotal,
    }


def _demand(g, r):
    """The demand-cone ranking data the ready view sorts and annotates by, taken
    straight from the engine (`Graph.demand_vector` / `demand_source`) so the page
    ships the same order `trck ready` prints and re-derives no cone math in JS.

    `demand_source` is `None` exactly when `r` already leads its own cone, which is
    also exactly when no `↑<priority>` marker is warranted — so the client renders
    the marker iff the field is set, with no rank comparison of its own."""
    src = g.demand_source(r)
    return list(g.demand_vector(r)), (src.id if src is not None else None)


def _issue_dict(g, ctx, r):
    demand, demand_source = _demand(g, r)
    return {
        "id": r.id,
        "title": r.title,
        "status": r.status,
        "priority": r.priority,
        "kind": r.kind,
        "points": r.points,
        "labels": list(r.labels),
        "resolution": r.resolution,
        "parent": r.parent,
        "children": [c.id for c in g.children_of(r)],
        "requires": [x.id for x in g.requires_of(r)],
        "dependents": [x.id for x in g.dependents_of(r)],
        "blocked": g.is_blocked(r),
        "ready": g.is_ready(r),
        "demand": demand,
        "demand_source": demand_source,
        "leaf": g.is_leaf(r),
        "terminal": g.is_terminal(r),
        "progress": _progress(g, r),
        "created": r.created,
        "started": r.started,
        "closed": r.closed,
        "spec": r.spec,
        "pr": r.pr,
        "body": _body_text(ctx, r),
    }


def _default_cmd():
    """The command prefix the page's copy-to-clipboard commands are built from:
    a global `trck` when one is on PATH, else a repo-relative path to the engine we
    loaded (`./trck`, or `./issues/trck` when vendored)."""
    if shutil.which("trck"):
        return "trck"
    p = getattr(E, "SELF_PATH", None)
    if p:
        p = Path(p)
        try:
            return "./" + str(p.relative_to(Path.cwd()))
        except ValueError:
            return str(p)
    return "trck"


def build_model(ctx, cmd=None):
    g = E.load_graph(ctx)
    cfg = ctx.cfg
    repo = (cfg.get("update") or {}).get("repo") or ctx.dir.parent.name
    issues = [_issue_dict(g, ctx, r) for r in g.rows]
    # Each id's shortest-unique-prefix length (git-short-hash style), computed with the
    # very helper the CLI uses so the page's highlight matches `trck list` exactly.
    plen = E.unique_prefix_lens([a["id"] for a in issues])
    for a in issues:
        a["plen"] = plen[a["id"]]
    # Authored dependency edges, blocker -> blocked (matches the engine's `deps`
    # ordering). Containment (parent/child) is intentionally excluded here.
    edges = [{"from": b, "to": a["id"]} for a in issues for b in a["requires"]]
    return {
        "repo": repo,
        "tracker": ctx.dir.name,
        "config": {
            "statuses": [{"name": s["name"], "role": s.get("role")} for s in cfg["statuses"]],
            "priorities": list(cfg.get("priorities", [])),
            "kinds": list(cfg.get("kinds", [])),
            "cmd": cmd or _default_cmd(),
        },
        "issues": issues,
        "edges": edges,
        "roots": sorted(a["id"] for a in issues if a["parent"] is None),
    }


# --------------------------------------------------------------------------- #
# Rendering — one self-contained document. The data island is `<`/`>`/`&`-escaped
# so an issue body can never break out of the <script> tag (or inject markup).
# --------------------------------------------------------------------------- #
def _json_island(model):
    raw = json.dumps(model, ensure_ascii=False)
    return (
        raw.replace("<", "\\u003c")
           .replace(">", "\\u003e")
           .replace("&", "\\u0026")
           .replace("\u2028", "\\u2028")
           .replace("\u2029", "\\u2029")
    )


def render_html(ctx, cmd=None):
    """The reusable core: a Ctx -> one self-contained HTML SPA string."""
    model = build_model(ctx, cmd=cmd)
    island = _json_island(model)
    title = _html.escape("trck · " + str(model["repo"]))
    return "".join([
        '<!doctype html>\n<html lang="en">\n<head>\n',
        '<meta charset="utf-8">\n',
        '<meta name="viewport" content="width=device-width, initial-scale=1">\n',
        f"<title>{title}</title>\n",
        "<style>\n", _CSS, "\n</style>\n</head>\n<body>\n",
        _SHELL,
        '<script type="application/json" id="trck-data">', island, "</script>\n",
        "<script>\n", _APP_JS, "\n</script>\n",
        "</body>\n</html>\n",
    ])


# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #
def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="trck-html",
        description="Generate a static HTML SPA to browse a trck tracker.",
    )
    ap.add_argument("path", nargs="?", help="tracker or repo path (default: discover from cwd)")
    ap.add_argument("--dir", help="tracker dir (like `trck --dir`)")
    ap.add_argument("-o", "--output",
                    help="output file, or - for stdout (default: <tracker>/issues.html)")
    ap.add_argument("--cmd",
                    help="command prefix for the page's copy-to-clipboard commands "
                         "(default: `trck` if on PATH, else a path to this engine)")
    args = ap.parse_args(argv)

    ctx = build_ctx_from(args.dir or args.path)
    doc = render_html(ctx, cmd=args.cmd)

    if args.output == "-":
        sys.stdout.write(doc)
        return
    out = Path(args.output) if args.output else (ctx.dir / "issues.html")
    out.write_text(doc)
    sys.stderr.write(f"trck-html: wrote {out} ({len(doc)} bytes)\n")


