_APP_JS = """\
const DATA = JSON.parse(document.getElementById('trck-data').textContent);
const $ = (s, r = document) => r.querySelector(s);
function el(tag, props = {}, ...kids) {
  const n = document.createElement(tag);
  for (const [k, v] of Object.entries(props)) {
    if (v == null) continue;
    if (k === 'class') n.className = v;
    else if (k === 'text') n.textContent = v;
    else if (k.slice(0, 2) === 'on') n.addEventListener(k.slice(2), v);
    else n.setAttribute(k, v);
  }
  for (const kid of kids) if (kid != null) n.append(kid);
  return n;
}

const byId = Object.fromEntries(DATA.issues.map(i => [i.id, i]));
const terminal = new Set(DATA.config.statuses.filter(s => s.role === 'terminal').map(s => s.name));
const prio = DATA.config.priorities;
const state = { q: '', status: '', priority: '', selected: null, edits: {}, view: 'list' };

// --- staged edits (v2 command-copy): key `${id}::${field}` -> new value ------
const editKey = (id, field) => id + '::' + field;
const stagedValue = (i, field) => {
  const k = editKey(i.id, field);
  return k in state.edits ? state.edits[k] : i[field];
};
const issueEdited = id => Object.keys(state.edits).some(k => k.slice(0, k.indexOf('::')) === id);
function setEdit(i, field, value) {
  const k = editKey(i.id, field);
  if (value === i[field]) delete state.edits[k];
  else state.edits[k] = value;
  renderList(); renderDetail(); renderPending();
}
function commandFor(id, field, value) {
  const c = DATA.config.cmd;
  if (field === 'status') return c + ' mv ' + id + ' ' + value;
  if (field === 'priority') return c + ' set ' + id + ' --priority ' + value;
  return '';
}
function pendingCommands() {
  return Object.entries(state.edits).map(([k, v]) => {
    const id = k.slice(0, k.indexOf('::')), field = k.slice(k.indexOf('::') + 2);
    return commandFor(id, field, v);
  });
}
function renderPending() {
  const box = $('#pending'), list = $('#plist'); list.textContent = '';
  const cmds = pendingCommands();
  if (!cmds.length) { box.hidden = true; return; }
  box.hidden = false;
  $('#pcount').textContent = cmds.length + (cmds.length === 1 ? ' command' : ' commands');
  for (const c of cmds) list.append(el('li', { class: 'pcmd', text: c }));
}
function flash(sel, msg) {
  const b = $(sel), t = b.textContent;
  b.textContent = msg; setTimeout(() => { b.textContent = t; }, 1200);
}
async function copyAll() {
  const text = pendingCommands().join('\\n');
  try { await navigator.clipboard.writeText(text); }
  catch (e) {
    const ta = el('textarea'); ta.value = text; document.body.append(ta);
    ta.select(); document.execCommand('copy'); ta.remove();
  }
  flash('#pcopy', 'Copied!');
}
function clearEdits() { state.edits = {}; renderList(); renderDetail(); renderPending(); }
function editSelect(i, field, values) {
  const cur = stagedValue(i, field);
  const sel = el('select', { class: 'sedit', onchange: e => setEdit(i, field, e.target.value) });
  for (const v of values) {
    const opt = el('option', { value: v, text: v });
    if (v === cur) opt.selected = true;
    sel.append(opt);
  }
  return sel;
}

function matches(i) {
  if (state.status && i.status !== state.status) return false;
  if (state.priority && i.priority !== state.priority) return false;
  if (state.q) {
    const hay = (i.id + ' ' + i.title + ' ' + (i.body || '') + ' ' + i.labels.join(' ')).toLowerCase();
    if (!hay.includes(state.q.toLowerCase())) return false;
  }
  return true;
}

function renderCounts() {
  const counts = {};
  for (const s of DATA.config.statuses) counts[s.name] = 0;
  for (const i of DATA.issues) counts[i.status] = (counts[i.status] || 0) + 1;
  const c = $('#counts'); c.textContent = '';
  for (const s of DATA.config.statuses)
    c.append(el('span', { class: 'count' }, el('b', { text: String(counts[s.name] || 0) }), ' ' + s.name));
  c.append(el('span', { class: 'count total' }, el('b', { text: String(DATA.issues.length) }), ' total'));
}

function link(id) {
  const i = byId[id];
  return el('a', { class: 'ilink', href: '#', text: '#' + id + (i ? ' ' + i.title : ''),
    onclick: e => { e.preventDefault(); select(id); } });
}
function links(ids) {
  const w = el('span');
  ids.forEach((id, n) => { if (n) w.append(', '); w.append(link(id)); });
  return w;
}

function row(i) {
  const cls = 'row' + (terminal.has(i.status) ? ' done' : '')
    + (i.id === state.selected ? ' sel' : '') + (issueEdited(i.id) ? ' edited' : '');
  const r = el('li', { class: cls, onclick: () => select(i.id) },
    el('span', { class: 'rid', text: '#' + i.id }),
    el('span', { class: 'rtitle', text: i.title }),
    el('span', { class: 'badge', text: i.priority }),
    el('span', { class: 'badge', text: i.status }));
  if (issueEdited(i.id)) r.append(el('span', { class: 'emark', title: 'has staged changes', text: '●' }));
  if (i.progress) r.append(el('span', { class: 'pct', text: i.progress.pct + '%' }));
  return r;
}

function renderList() {
  const list = $('#list'); list.textContent = '';
  const rows = DATA.issues.filter(matches).sort((a, b) =>
    (prio.indexOf(a.priority) - prio.indexOf(b.priority)) || a.id.localeCompare(b.id));
  if (!rows.length) { list.append(el('li', { class: 'empty', text: 'No matching issues.' })); return; }
  for (const i of rows) list.append(row(i));
}

function meta(label, node) {
  return node == null ? null
    : el('div', { class: 'm' }, el('span', { class: 'mk', text: label }), node);
}

function renderDetail() {
  const d = $('#detail'); d.textContent = '';
  const i = byId[state.selected];
  if (!i) { d.append(el('p', { class: 'empty', text: 'Select an issue.' })); return; }
  d.append(el('h2', {}, el('span', { class: 'rid', text: '#' + i.id + ' ' }), i.title));
  const m = el('div', { class: 'meta' });
  m.append(meta('status', el('span', { class: 'badge', text: i.status })));
  m.append(meta('priority', el('span', { class: 'badge', text: i.priority })));
  m.append(meta('kind', i.kind));
  if (i.resolution) m.append(meta('resolution', i.resolution));
  if (i.labels.length) m.append(meta('labels', i.labels.join(', ')));
  if (i.progress) m.append(meta('progress',
    i.progress.pct + '% (' + i.progress.done_points + '/' + i.progress.total_points + ' pts)'));
  if (i.parent) m.append(meta('parent', link(i.parent)));
  if (i.children.length) m.append(meta('children', links(i.children)));
  if (i.requires.length) m.append(meta('requires', links(i.requires)));
  if (i.dependents.length) m.append(meta('blocks', links(i.dependents)));
  d.append(m);

  const stage = el('div', { class: 'stage' }, el('span', { class: 'stagek', text: 'stage a change' }));
  stage.append(el('label', { class: 'sfield' }, 'status',
    editSelect(i, 'status', DATA.config.statuses.map(s => s.name))));
  stage.append(el('label', { class: 'sfield' }, 'priority',
    editSelect(i, 'priority', DATA.config.priorities)));
  d.append(stage);

  d.append(el('pre', { class: 'body', text: i.body || '' }));
}

function select(id) {
  state.selected = id;
  renderList(); renderDetail();
  if (state.view === 'graph') renderGraph();
}

// --- v3 dependency graph: SVG layered DAG from authored edges ----------------
const SVGNS = 'http://www.w3.org/2000/svg';
function sv(tag, props = {}, ...kids) {
  const n = document.createElementNS(SVGNS, tag);
  for (const [k, v] of Object.entries(props)) {
    if (v == null) continue;
    if (k === 'text') n.textContent = v;
    else if (k.slice(0, 2) === 'on') n.addEventListener(k.slice(2), v);
    else n.setAttribute(k, v);
  }
  for (const kid of kids) if (kid != null) n.append(kid);
  return n;
}
const NODE_W = 150, NODE_H = 32, COL_GAP = 20, ROW_GAP = 46, PAD = 14, COMP_GAP = 30;
