#!/usr/bin/env bash
#
# Pre-commit guard for the trck dev repo: refuse a commit that would leave the
# issue tracker under `issues/` inconsistent.
#
# Enable it once per clone:  git config core.hooksPath scripts/hooks
#
# This is a convenience, not a gate — `--no-verify` skips it, and it does nothing
# when no engine can be found. The check that binds runs in CI.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

# The build tree first: in this repo the engine under change is the one that should
# answer, and an installed trck would speak for a different version without saying so.
if [ -x target/release/trck ]; then
    engine=(target/release/trck)
elif [ -x target/debug/trck ]; then
    engine=(target/debug/trck)
elif command -v trck >/dev/null 2>&1; then
    engine=(trck)
else
    echo "pre-commit: no trck found — skipping the tracker check." >&2
    echo "            build one with 'cargo build --release' to enable it." >&2
    exit 0
fi

"${engine[@]}" check || {
    echo "pre-commit: trck tracker is inconsistent — aborting commit." >&2
    exit 1
}
